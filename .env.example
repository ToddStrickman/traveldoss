# TravelDoss environment keys
#
# Copy to `.env` and fill in the values. Names only here, never values.
# In production Lovable injects these; locally the app throws
# "Missing Supabase environment variable(s)" from
# src/integrations/supabase/client.server.ts without the Supabase ones.
#
# Keys prefixed VITE_ are bundled into the browser and are public by design.
# Everything else is server-only and must never be exposed to the client.

# ── Supabase (required) ──────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server-only: bypasses RLS
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=             # also the MCP OAuth issuer (src/lib/mcp/index.ts)

# ── Lovable connector gateway (server-only) ─────────────────────────────────
LOVABLE_API_KEY=                      # bearer for connector-gateway.lovable.dev
GOOGLE_DOCS_API_KEY=                  # Google Docs connector (dossier export)
FIRECRAWL_API_KEY=                    # destination research scrapes

# ── Google Maps ─────────────────────────────────────────────────────────────
# Mapping needs no keys at all: stops are located via OpenStreetMap (Photon +
# Nominatim) and the basemap is OpenFreeMap's public vector tiles.
VITE_MAP_STYLE_URL=                   # optional: full MapLibre style URL; empty = the skin-tinted plate

# ── Optional ────────────────────────────────────────────────────────────────
VITE_POSTHOG_KEY=                     # product analytics; analytics no-op when unset
VITE_POSTHOG_HOST=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=   # set by Lovable; not read by app code
SUPABASE_PROJECT_ID=                  # set by Lovable; not read by app code
